# ==============================================================================
# Leakers$ CAPTCHA - Environment Configuration Template
# Duplicate this file as .env and populate your actual bot credentials.
# ==============================================================================

# Discord Bot Authentication Token (Obtain from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Database Configuration
DATABASE_PATH=leakers_captcha.db

# Default CAPTCHA Behavior Settings
# Available styles: Collage, Snow, Corrosion, SpiderWeb, CrossShadow,
# CrossShadow2, Cut, Darts, Distortion, Split, Split2, Stitch, Strippy, Random
DEFAULT_CAPTCHA_STYLE=MarketShapes
DEFAULT_EXPIRATION_SECONDS=180
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_COOLDOWN_SECONDS=300
CAPTCHA_LENGTH=6

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

